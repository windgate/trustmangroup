---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { firstImage } from '../lib/assets';

const jlaLogo = firstImage('jla-logo.png');
---
<Base title="Estate Liquidations" description="Estate liquidations conducted under strict trust principles with no conflicts of interest or self-dealing, backed by a 49-year reputation for integrity. Delivered with affiliate JLA Treasures.">
  <PageHero title="Estate Liquidations" image="estate-liquid-wide1.jpg" />

  <section class="band">
    <div class="container layout">
      {jlaLogo && <a class="logo" href="https://jlatreasures.com" rel="noopener" target="_blank"><img src={jlaLogo} alt="JLA Treasures" width="300" /></a>}
      <div class="prose">
        <p class="big">Our clients’ needs come first. Period.</p>
        <p>We stake a 49-year business reputation of absolute integrity in the personal trust and estate management business on each and every engagement.</p>
        <p>While estate liquidations do not constitute <em>formal</em> fiduciary relationships, they certainly qualify under the “informal” fiduciary standard in Texas. We conduct our business with adherence to strict trust principles. We always avoid conflicts of interest and self-dealing.</p>
        <p>Professionals can rest assured that our experience and reputation will help to protect them as they administer their clients’ property.</p>
        <a class="btn" href="https://jlatreasures.com" rel="noopener" target="_blank">Visit JLA Treasures</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .layout { display: grid; grid-template-columns: minmax(0, 300px) 1fr; gap: clamp(2rem, 5vw, 4rem); align-items: center; }
  .layout:not(:has(.logo)) { grid-template-columns: 1fr; }
  .big { font-family: var(--font-heading); font-size: 1.5rem; color: var(--burgundy); }
  @media (max-width: 800px) { .layout { grid-template-columns: 1fr; } .logo { max-width: 300px; } }
</style>
