---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
import { firstImage } from '../lib/assets';

const reverseLogo = firstImage('trust-logo-reverse-400.png', 'trust-logo-reverse-400-2.png');
const aboutImage = firstImage('canstockphoto75084974-450x400.jpg');
---
<Base title="Home">
  <!-- Hero: photo only, no color overlay (as on the live site). Text shadow keeps the type legible. -->
  <section class="hero">
    <div class="container hero-inner">
      {reverseLogo
        ? <img class="hero-logo" src={reverseLogo} alt="Trust Management Group" width="400" />
        : <p class="hero-wordmark" aria-hidden="true">TRUST<small>MANAGEMENT GROUP</small></p>}
      <h1>Experience. Expertise. Integrity.</h1>
    </div>
  </section>

  <section class="band soft">
    <div class="container about">
      {aboutImage && <img class="about-img" src={aboutImage} alt="Pen resting on a Fiduciary Duty seal" width="450" height="400" />}
      <div>
        <h2>About Us</h2>
        <div class="heading-rule"></div>
        <p>Trust Management Group, LLP was formed in {site.since} by longtime trust and wealth management professional Gary Matesic, along with Plano entrepreneur, grant writer and Wharton School alum Mike Shea, to provide litigation consulting and expert witness testimony in breach of fiduciary duty cases.</p>
        <a class="btn" href="/about">Learn More</a>
      </div>
    </div>
  </section>

  <section class="band">
    <div class="container">
      <h2>Our Services</h2>
      <div class="heading-rule"></div>
      <div class="grid grid-3">
        <a class="tile" href="/consulting">
          <h3>Consulting</h3>
          <p>Fiduciary reviews, estate management assistance, litigation support, expert witness testimony, trustee selection, investment manager searches, and attorney referrals.</p>
          <span class="more">Explore consulting →</span>
        </a>
        <a class="tile" href="/appraisals">
          <h3>Appraisals</h3>
          <p>USPAP-compliant appraisals of modern, classic and antique automobiles for insurance, litigation, diminished value, and Federal Estate Tax purposes.</p>
          <span class="more">Explore appraisals →</span>
        </a>
        <a class="tile" href="/estate-liquidations">
          <h3>Estate Liquidations</h3>
          <p>Strict trust principles, no conflicts of interest, and a 49-year reputation for absolute integrity, delivered with our affiliate JLA Treasures.</p>
          <span class="more">Explore liquidations →</span>
        </a>
      </div>
    </div>
  </section>

  <section class="band burgundy">
    <div class="container stats">
      <div><strong>25</strong><span>controversies consulted on in our first 10 years</span></div>
      <div><strong>10</strong><span>depositions</span></div>
      <div><strong>9</strong><span>trials testified in</span></div>
      <div><strong>$1.93M</strong><span>achieved on a 79-vehicle collection (estimate: $1.7M)</span></div>
    </div>
  </section>

  <section class="band soft cta">
    <div class="container">
      <h2>Please call or email to discuss your particular needs.</h2>
      <p><a href={site.phoneHref}><strong>{site.phone}</strong></a> &nbsp;|&nbsp; <a href={`mailto:${site.email}`}>{site.email}</a></p>
      <a class="btn" href="/contact">Contact Us</a>
    </div>
  </section>
</Base>

<style>
  .hero {
    background-color: var(--charcoal-dark);
    background-image: url('/images/home-hero.jpg');
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    min-height: clamp(420px, 62vh, 640px);
    display: flex;
    align-items: center;
    text-align: center;
  }
  .hero-inner { display: flex; flex-direction: column; align-items: center; gap: 1.5rem; padding-block: 3rem; }
  .hero-logo { width: min(400px, 70vw); height: auto; filter: drop-shadow(1px 2px 4px rgba(0,0,0,.45)); }
  .hero-wordmark { font-family: var(--font-heading); font-weight: 700; font-size: clamp(3rem, 9vw, 5.5rem); color: #fff; line-height: 1; letter-spacing: .06em; margin: 0; text-shadow: 2px 2px 3px #272727; }
  .hero-wordmark small { display: block; font-size: .22em; letter-spacing: .3em; margin-top: .4em; font-weight: 500; }
  .hero h1 {
    color: #fff; font-weight: 700; margin: 0;
    font-size: clamp(2rem, 6.2vw, 3.75rem);
    text-shadow: 2px 2px 3px #272727;
  }
  @media (max-width: 700px) { .hero { min-height: 380px; background-position: 60% center; } }

  .about { display: grid; grid-template-columns: minmax(0, 450px) 1fr; gap: clamp(1.5rem, 5vw, 4rem); align-items: center; }
  .about:not(:has(.about-img)) { grid-template-columns: 1fr; max-width: 760px; }
  .about-img { width: 100%; height: auto; }
  @media (max-width: 800px) { .about { grid-template-columns: 1fr; } .about-img { max-width: 450px; } }

  .tile { display: block; text-decoration: none; background: #fff; border: 1px solid var(--line); border-top: 3px solid var(--burgundy); padding: 1.6rem; transition: box-shadow .15s, transform .15s; }
  .tile:hover { box-shadow: 0 8px 22px rgba(0,0,0,.1); transform: translateY(-2px); }
  .tile h3 { color: var(--burgundy); }
  .tile p { color: var(--muted); }
  .more { color: var(--navy-blue); font-weight: 600; font-size: .92rem; }

  .stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); gap: 2rem; text-align: center; }
  .stats strong { display: block; font-family: var(--font-heading); font-weight: 500; font-size: clamp(2.3rem, 5vw, 3rem); color: #fff; line-height: 1.1; }
  .stats span { font-size: .93rem; color: #f3dde1; }

  .cta { text-align: center; }
  .cta p { font-size: 1.1rem; }
</style>
