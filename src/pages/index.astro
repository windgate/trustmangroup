---
import Base from '../layouts/Base.astro';
import { site, consultingServices } from '../data/site';
---
<Base title="Home">
  <section class="hero">
    <div class="container hero-inner">
      <span class="eyebrow">Dallas, Texas · Since {site.since}</span>
      <h1>Experience. Expertise. <em>Integrity.</em></h1>
      <p class="lede">Expert consulting in all forms of personal trust and estate matters, including fiduciary litigation, collector vehicle appraisals, and estate liquidations.</p>
      <div class="actions">
        <a class="btn btn-primary" href="/contact">Contact Gary Matesic</a>
        <a class="btn btn-outline" href="/consulting">Our Services</a>
      </div>
    </div>
  </section>

  <section class="band">
    <div class="container grid grid-2 about">
      <div>
        <span class="eyebrow">About Us</span>
        <h2>Trusted counsel on fiduciary matters for over two decades</h2>
        <hr class="rule" />
      </div>
      <div>
        <p>Trust Management Group, LLP was formed in {site.since} by longtime trust and wealth management professional Gary Matesic, along with Plano entrepreneur, grant writer and Wharton School alum Mike Shea, to provide litigation consulting and expert witness testimony in breach of fiduciary duty cases.</p>
        <a class="btn btn-outline-dark" href="/about">Learn More</a>
      </div>
    </div>
  </section>

  <section class="band alt">
    <div class="container">
      <span class="eyebrow">What We Do</span>
      <h2>Services</h2>
      <hr class="rule" />
      <div class="grid grid-3">
        <a class="card tile" href="/consulting">
          <h3>Consulting</h3>
          <p>Fiduciary reviews, estate management assistance, litigation support, expert witness testimony, trustee selection, investment manager searches, and attorney referrals.</p>
          <span class="more">Explore consulting →</span>
        </a>
        <a class="card tile" href="/appraisals">
          <h3>Appraisals</h3>
          <p>USPAP-compliant appraisals of modern, classic and antique automobiles for insurance, litigation, diminished value, and Federal Estate Tax purposes.</p>
          <span class="more">Explore appraisals →</span>
        </a>
        <a class="card tile" href="/estate-liquidations">
          <h3>Estate Liquidations</h3>
          <p>Strict trust principles, no conflicts of interest, and a 49-year reputation for absolute integrity, delivered through our affiliate JLA Treasures.</p>
          <span class="more">Explore liquidations →</span>
        </a>
      </div>
    </div>
  </section>

  <section class="band dark">
    <div class="container stats">
      <div><strong>25</strong><span>controversies consulted on in our first 10 years</span></div>
      <div><strong>10</strong><span>depositions</span></div>
      <div><strong>9</strong><span>trials testified in</span></div>
      <div><strong>$1.93M</strong><span>achieved on a 79-vehicle collection (estimate: $1.7M)</span></div>
    </div>
  </section>

  <section class="band cta">
    <div class="container">
      <h2>Please call or email to discuss your particular needs.</h2>
      <p><a href={site.phoneHref}><strong>{site.phone}</strong></a> &nbsp;|&nbsp; <a href={`mailto:${site.email}`}>{site.email}</a></p>
      <a class="btn btn-primary" href="/contact">Get in Touch</a>
    </div>
  </section>
</Base>

<style>
  .hero {
    background:
      linear-gradient(135deg, rgba(15,31,58,.97), rgba(31,56,101,.93)),
      var(--navy-900);
    color: #dfe5ef;
    padding-block: clamp(4.5rem, 12vw, 8.5rem);
    border-bottom: 4px solid var(--brass);
  }
  .hero h1 { color: #fff; max-width: 14ch; font-size: clamp(2.6rem, 7vw, 4.75rem); }
  .hero h1 em { color: var(--brass-light); font-style: italic; }
  .hero .eyebrow { color: var(--brass-light); }
  .hero .lede { color: #c9d3e3; margin-bottom: 2rem; }
  .actions { display: flex; gap: 1rem; flex-wrap: wrap; }
  .about { align-items: start; gap: clamp(1.5rem, 5vw, 4rem); }
  .tile { text-decoration: none; color: inherit; display: block; transition: transform .15s, box-shadow .15s; }
  .tile:hover { transform: translateY(-3px); box-shadow: 0 10px 24px rgba(15,31,58,.1); color: inherit; }
  .more { color: var(--brass); font-weight: 600; font-size: .95rem; }
  .stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); gap: 2rem; text-align: center; }
  .stats strong { display: block; font-family: var(--font-display); font-size: clamp(2.4rem, 5vw, 3.2rem); color: var(--brass-light); line-height: 1.1; }
  .stats span { font-size: .95rem; color: #c9d3e3; }
  .cta { text-align: center; }
  .cta p { font-size: 1.15rem; }
</style>
