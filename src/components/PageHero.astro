---
import { firstImage } from '../lib/assets';
interface Props { title: string; image?: string }
const { title, image } = Astro.props;
const src = image ? firstImage(image) : undefined;
---
<!-- Banner photo shown as-is (no color overlay), matching the live site -->
<section class="page-hero" style={src ? `background-image: url('${src}')` : undefined}>
  <div class="container">
    <h1>{title}</h1>
  </div>
</section>

<style>
  .page-hero {
    background-color: var(--burgundy);
    background-size: cover;
    background-position: center;
    min-height: clamp(200px, 26vw, 320px);
    display: flex;
    align-items: center;
  }
  h1 {
    color: #fff;
    font-weight: 400;
    font-size: clamp(2rem, 4.6vw, 3.1rem);
    margin: 0;
    padding-block: 2rem;
    text-shadow: 1px 2px 6px rgba(0,0,0,.65);
  }
</style>
