---
import Logo from './Logo.astro';
import { nav, site } from '../data/site';
const path = Astro.url.pathname.replace(/(\.html)?\/?$/, '') || '/';
---
<header class="site-header">
  <div class="topbar">
    <div class="container topbar-inner">
      <a href={site.phoneHref}>{site.phone}</a>
      <a href={`mailto:${site.email}`}>{site.email}</a>
    </div>
  </div>
  <div class="container bar">
    <a class="brand" href="/" aria-label={`${site.shortName} home`}><Logo /></a>
    <button class="menu-toggle" aria-expanded="false" aria-controls="primary-nav" aria-label="Toggle menu">
      <span></span><span></span><span></span>
    </button>
    <nav id="primary-nav" aria-label="Primary">
      <ul>
        {nav.map((item) => (
          <li><a href={item.href} aria-current={path === item.href ? 'page' : undefined}>{item.label}</a></li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header { background: #fff; position: sticky; top: 0; z-index: 50; box-shadow: 0 1px 6px rgba(0,0,0,.12); }
  .topbar { background: var(--burgundy); font-size: .88rem; }
  .topbar-inner { display: flex; justify-content: flex-end; gap: 1.75rem; padding-block: .3rem; }
  .topbar a { color: #f0f0f0; text-decoration: none; font-weight: 700; }
  .topbar a:hover { color: #fff; text-decoration: underline; }
  .bar { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding-block: .5rem; }
  .brand { display: block; }
  .brand :global(img) { width: 118px; height: auto; }
  nav ul { list-style: none; display: flex; gap: .15rem; margin: 0; padding: 0; }
  nav a { display: block; padding: .5rem .75rem; text-decoration: none; color: var(--burgundy); font-size: .98rem; font-weight: 700; }
  nav a:hover { color: var(--navy-blue); }
  nav a[aria-current='page'] { color: var(--navy-blue); }
  .menu-toggle { display: none; background: none; border: 0; padding: .6rem; cursor: pointer; }
  .menu-toggle span { display: block; width: 24px; height: 3px; background: var(--navy-blue); margin: 4px 0; }

  @media (max-width: 900px) {
    .topbar-inner { justify-content: center; gap: 1rem; flex-wrap: wrap; }
    .menu-toggle { display: block; }
    nav { display: none; position: absolute; left: 0; right: 0; top: 100%; background: #fff; box-shadow: 0 6px 10px rgba(0,0,0,.12); }
    nav.open { display: block; }
    nav ul { flex-direction: column; padding: .25rem var(--gutter) 1rem; }
    nav a { padding: .8rem 0; border-bottom: 1px solid var(--line); }
  }
</style>

<script>
  const btn = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const nav = document.getElementById('primary-nav');
  btn?.addEventListener('click', () => {
    const open = nav?.classList.toggle('open') ?? false;
    btn.setAttribute('aria-expanded', String(open));
  });
</script>
