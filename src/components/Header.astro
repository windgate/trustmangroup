---
import Logo from './Logo.astro';
import { nav, site } from '../data/site';
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---
<header class="site-header">
  <div class="topbar">
    <div class="container topbar-inner">
      <a href={site.phoneHref}>{site.phone}</a>
      <a href={`mailto:${site.email}`}>{site.email}</a>
    </div>
  </div>
  <div class="container bar">
    <a class="brand" href="/" aria-label={`${site.shortName} home`}>
      <Logo />
      <span class="brand-text">
        <span class="brand-name">Trust Management Group</span>
        <span class="brand-sub">Since {site.since}</span>
      </span>
    </a>
    <button class="menu-toggle" aria-expanded="false" aria-controls="primary-nav" aria-label="Toggle menu">
      <span></span><span></span><span></span>
    </button>
    <nav id="primary-nav" aria-label="Primary">
      <ul>
        {nav.map((item) => (
          <li>
            <a href={item.href} aria-current={path === item.href ? 'page' : undefined}>{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header { background: var(--paper); border-bottom: 1px solid var(--line); position: sticky; top: 0; z-index: 50; }
  .topbar { background: var(--navy-900); font-size: .85rem; }
  .topbar-inner { display: flex; justify-content: flex-end; gap: 1.5rem; padding-block: .4rem; }
  .topbar a { color: #dfe5ef; text-decoration: none; }
  .topbar a:hover { color: var(--brass-light); }
  .bar { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding-block: .8rem; }
  .brand { display: flex; align-items: center; gap: .8rem; text-decoration: none; color: var(--navy-900); }
  .brand:hover { color: var(--navy-900); }
  .brand-text { display: flex; flex-direction: column; line-height: 1.15; }
  .brand-name { font-family: var(--font-display); font-weight: 600; font-size: 1.25rem; }
  .brand-sub { font-size: .72rem; letter-spacing: .18em; text-transform: uppercase; color: var(--brass); font-weight: 600; }
  nav ul { list-style: none; display: flex; gap: .25rem; margin: 0; padding: 0; }
  nav a {
    display: block; padding: .5rem .8rem; text-decoration: none; color: var(--ink);
    font-size: .93rem; font-weight: 500; border-bottom: 2px solid transparent;
  }
  nav a:hover { color: var(--navy-700); border-bottom-color: var(--brass-light); }
  nav a[aria-current='page'] { color: var(--navy-900); border-bottom-color: var(--brass); font-weight: 600; }
  .menu-toggle { display: none; background: none; border: 1px solid var(--line); border-radius: var(--radius); padding: .6rem; cursor: pointer; }
  .menu-toggle span { display: block; width: 22px; height: 2px; background: var(--navy-900); margin: 4px 0; }

  @media (max-width: 880px) {
    .topbar-inner { justify-content: center; gap: 1rem; flex-wrap: wrap; }
    .menu-toggle { display: block; }
    nav { display: none; position: absolute; left: 0; right: 0; top: 100%; background: var(--paper); border-bottom: 1px solid var(--line); }
    nav.open { display: block; }
    nav ul { flex-direction: column; padding: .5rem var(--gutter) 1rem; }
    nav a { padding: .8rem 0; border-bottom: 1px solid var(--line); }
  }
</style>

<script>
  const btn = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const nav = document.getElementById('primary-nav');
  btn?.addEventListener('click', () => {
    const open = nav?.classList.toggle('open') ?? false;
    btn.setAttribute('aria-expanded', String(open));
  });
</script>
