---
import { site } from '../data/site';
import { firstImage } from '../lib/assets';
const year = new Date().getFullYear();
const reverseLogo = firstImage('trust-logo-reverse-400.png', 'trust-logo-reverse-400-2.png');
---
<footer class="site-footer">
  <div class="main">
    <div class="container inner">
      <div class="brand">
        {reverseLogo
          ? <img src={reverseLogo} alt="Trust Management Group" width="170" />
          : <span class="wordmark">TRUST<small>MANAGEMENT GROUP</small></span>}
        <p class="since">Since {site.since}</p>
      </div>
      <address>
        <strong>{site.principal}</strong><br />
        {site.name}<br />
        {site.address.map((l) => <>{l}<br /></>)}
      </address>
    </div>
  </div>
  <div class="bar">
    <div class="container">© {year} {site.name}. All Rights Reserved.</div>
  </div>
</footer>

<style>
  .site-footer { font-size: .95rem; }
  .main { background: var(--charcoal); color: #e3e3e3; padding-block: 3rem; }
  .inner { display: flex; justify-content: center; align-items: center; gap: 2.5rem; flex-wrap: wrap; }
  .brand { text-align: center; }
  .brand img { margin-inline: auto; }
  .wordmark { display: block; font-family: var(--font-heading); font-weight: 700; font-size: 2.4rem; letter-spacing: .08em; color: #fff; line-height: 1; }
  .wordmark small { display: block; font-size: .62rem; letter-spacing: .22em; margin-top: .35rem; font-weight: 500; }
  .since { color: #fff; font-family: Georgia, 'Times New Roman', serif; font-style: italic; font-size: 1.15rem; margin: .5rem 0 0; }
  address { font-style: normal; line-height: 1.6; }
  address strong { color: #fff; font-weight: 400; }
  .bar { background: var(--charcoal-dark); color: #b0b0b0; text-align: center; padding-block: 1rem; font-size: .88rem; }
</style>
